{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["es2022", "dom"],
    "types": ["node", "vscode"],
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src", "test"]
}
